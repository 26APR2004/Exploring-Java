//Inheritance in Interface
package com.Silver_Oak;
interface f_1
{
	void method1();
	void method2();
}
interface f_2 extends f_1
{
	void method3();
	void method4();
}

class Test implements f_2
{

	@Override
	public void method1() {
		System.out.println("Method_1");
		
	}

	@Override
	public void method2() {
		System.out.println("Method_2");	
	}

	@Override
	public void method3() {
		System.out.println("Method_3");	
	}

	@Override
	public void method4() {
		System.out.println("Method_4");	
	}
	
}
public class InheritanceInInterface {
    public static void main(String[]args)
    {
    	Test t1=new Test();
    	t1.method1();
    	t1.method4();
    }
}

