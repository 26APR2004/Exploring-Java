package com.Silver_Oak;

interface TvRemote
{
	void switch_Off();
	void volume_i();
	void volume_d();
}
interface SmartTvRemote extends TvRemote
{
	void speech_Recog();
	void youTube();
	
}

class Tv implements SmartTvRemote
{

	@Override
	public void switch_Off() {
		System.out.println("switch_Off the Tv");
		
	}

	@Override
	public void volume_i() {
		System.out.println("increasing the volume of Tv");
		
	}

	@Override
	public void volume_d() {
		System.out.println("decreasing the volume of Tv");
		
	}

	@Override
	public void speech_Recog() {
		System.out.println("Recognizing the spech!");
		
	}

	@Override
	public void youTube() {
		System.out.println("Whatching YouTube on Tv");
		
	}
	
}
