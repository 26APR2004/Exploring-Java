// Java program to find max element in the array;
package com.company;

public class FindMaxInArray {
	public static void main(String args[]) {
 int arr[]= {3,58,6,8,1,56};
 int max=arr[0];
 
 for(int i=0;i<arr.length;i++)
 {
	 
	 if(max<arr[i])
		 max=arr[i];
	 else
		 continue;
 }
 System.out.println(max);
}}
