// Working of Vector
package com.company;
import java.io.*;
import java.util.*;
public class WorkingOfVector{

	public static void main(String[]args)
	{
		//Declaring Vector
		Vector<Integer>v=new Vector<Integer>();
		
		//Appending new elements in the list
		for(int i=0;i<5;i++)
		{ v.add(i);}
		
		// Printing elements
		System.out.println(v);
		
		// Removing element from index 3
		v.remove(3);
		
		// Displaying list after deleting
		System.out.println(v);
		
		//Printing elements on by one 
		for(int i=0;i<v.size();i++)
			System.out.print(v.get(i)+" ");
	}
}

