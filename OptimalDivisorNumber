package com.company;
import java.util.ArrayList; //List
public class OptimalDivisorNumber {
 public static ArrayList<Integer> Divisor(int n)
 {
	 ArrayList<Integer> Divisor1=new ArrayList<>();
	 int sqrt=(int)Math.sqrt(n);
	 for(int i=1;i<=sqrt;i++)
	 {
		 if(n%i==0)
		 { Divisor1.add(i);
		 if(n/i!=i)
			 Divisor1.add(n/i);}
				
				
	 }
	 return Divisor1 ;
 }
	public static void main(String args[])
	{
		int n=12;
		ArrayList<Integer> Divisors=Divisor(n);
		System.out.print("Divisor of "+n+" are:\n");
		for(int i:Divisors)
		{
		
			System.out.print(i+" ");
		}
		
	
	}
}
