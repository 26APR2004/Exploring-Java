// Java program to display sum of first n even natural number using while loop
package com.company;
import java.util.Scanner;
public class SumOfEvenNumber {
 public static void main(String []args)
 {
	 Scanner sc=new Scanner(System.in);
	 System.out.print("Enter the value of n:");
	 int n=sc.nextInt();
	 int sum=0;
	 int i=0;
	 while(i<n)
	 {
		 if(i%2==0)
		 {
			 sum+=i;
		 }
		 i++;
	 }
	 System.out.printf("Sum of first %d upto natural numbers is :%d",n,sum);
 }
}
