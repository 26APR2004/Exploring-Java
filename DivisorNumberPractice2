package com.company;
import java.util.Scanner;
public class DivisorNumberPractice2 {
	static public int[] Divisor(int n,int []size)
	{
		int Divisor[]=new int[n];
		int count=0;
		for(int i=1;i<=n;i++)
		{
			if(n%i==0)
				Divisor[count++]=i;
		}
		size[0]=count;
		return Divisor;
	}
public static void main(String[]args)
{
	System.out.print("Enter the number:");
	Scanner sc=new Scanner(System.in);
	int n=sc.nextInt();
	int size[]=new int[1];
	int[] divisor=Divisor(n,size);
	System.out.print("Divisor of "+n+" are:\n");
	for(int i=0;i<size[0];i++)
	{
		System.out.print(divisor[i]+" ");
	}
	 //divisor = null;
}
}
