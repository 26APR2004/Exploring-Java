/*
 * Create a class Game,which allows a user to play "Guess the number".
 * TimeComplexity=O(n) ,Where n =100;
 * Space Complexity=O(1);
 */
package com.company;
import java.util.Random;
import java.util.Scanner;
class Game
{ Random rd =new Random();
  int random_no=rd.nextInt(100);
	int noOfGuesses=0;
	int user_no;
	int R;
	public Game() // Constructor for random number
	{
		 R=random_no;
	}
	public void  takeUserInput(int n)
	{
		//System.out.println(R);
		user_no=n;
		noOfGuesses++;
		incorrectNumber();
	}
	public void input()
	{    System.out.print("Eneter the number Again:");
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		takeUserInput(n);
	}
	public void incorrectNumber()
	{
		if(R==user_no)
			{System.out.println("Correct Guess");}
		 else if(R<user_no)
		{ System.out.println("Guessed number is greater!");input();}
		 else if(R>user_no)
			{ System.out.println("Guessed number is smaller!");input();}
	}
	public int getCounts()
	{
		return noOfGuesses;
	}
	
}
public class GuessTheNumber {
public static void main(String[]args)
{
	 System.out.print("Eneter the number:");
	Scanner sc=new Scanner(System.in);
	int n=sc.nextInt();
	Game g1=new Game();
	g1.takeUserInput(n);
	System.out.print("You get the correct guess after "+g1.getCounts()+" times");

}}
