package com.company;
//Custom Class
class student
{
	//Arguments
	int age;
	String name;
	int PRN;
	void displaydetails()  // Method
	{
		System.out.println("Age of Student :"+age+" old");
		System.out.println("Nmae of Student: "+name);
		System.out.println("PRN of Student: "+PRN);
	}
}
public class CutomeClassInJava {

public static void main(String[]args)
{
	student s1=new student();  // Student Object
	// Setting values
	s1.age=20;
	s1.name="Sujal";
	s1.PRN=72;
	// Printing information
	s1.displaydetails();
	
	
}
}
