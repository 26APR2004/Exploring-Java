/* Create a class Employee with following properties and methods:
 * salary(properties)
 * getSalary(method)
 * name(properties)
 * getName(method)
 * setName(method)
 */
package com.company;

class Employee
{
	int salary;
	String name;
	
	int getSalary()
	{
		return salary;
	}
	String getName()
	{
		return name;
	}
	void setName(String n)
	{
		name=n;
	}
}
public class EmployeePractice {
	
public static void main(String args[])
{
	Employee e1=new Employee();
	e1.salary=1234;
	System.err.println("$"+e1.getSalary());
	e1.name="Sujal";
	System.err.println(e1.getName());
	e1.setName("Sahil");
	System.err.println(e1.getName());
}
}
