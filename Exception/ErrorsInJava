// Types of Erros in java
package com.Silver_Oak;
import java.util.Scanner;
public class ErrorsInJava {
     public static void main(String[]args)
     {
    	  // Syntax error
    	    //int a=20
    	    //b=12;
    	 
    	 // Logical error
    	 System.out.println(2);
    	 for(int i=1;i<5;i++)
    	 {
    		 System.out.println(2*i+1);
    	 }
    	  //It's give 9 as prime number, so means it's logical error
    	 
    	 // Runtime error
    	 // If i enter "0" then it show ArithmeticException
    	 System.out.println("Enter the number:");
    	 Scanner sc=new Scanner(System.in);
    	 int a=sc.nextInt();
    	 System.out.println(1000/a);
     }
}
