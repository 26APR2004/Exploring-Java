// Java program to print factorial of any number bu using recursion;
package com.company;
import java.util.Scanner;
public class FacorialInJavaByUsingRecursion {
     public int factorial(int a)
     {
    	 if(a==0 || a==1)
    		 return 1;
    	 else
    	 return a*factorial(a-1);
    	 
     }
     public int iterativeFacorial(int a)
     {
    	 int fact_1=1;
		   for(int i=1;i<=a;i++)
		   fact_1*=i;
    	 return fact_1;
     }
	public static void main(String[]args)
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter the number:");
		int number=sc.nextInt();
		//Recursion way
		FacorialInJavaByUsingRecursion c1=new FacorialInJavaByUsingRecursion();
		int fact=c1. factorial(number);
		System.out.printf("Factorial of number %d is:%d\n",number,fact);
		//iterative way
		int _fact=c1.iterativeFacorial(number);
		System.out.printf("Factorial of number %d is:%d",number,_fact);
		
	}
}
