// Denostration of use of Boundary matches - (^,$) 
package Regex;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
public class BoundaryMathches {
     public static void main(String[]args)
     {
    	 Pattern p= Pattern.compile("^[Tt].*[oO]$");
    	 Matcher m=p.matcher("the sun was smaller that dayo");
    	 boolean result=m.matches();
    	 System.out.println(result);
     }
}
