// Use of Constructors in Thread class  -Thread(String name)

package com.Silver_Oak;

class use_Constructor_1 extends Thread
{
	use_Constructor_1()  //Automatically generated names are of the form "Thread-"+n, where n is an integer.
	{
		super();
	}
	use_Constructor_1(String name)  //  User generated name
	{
		super(name);
	} 
	public void run()
	{ 
		int i=0;
		while(i<14)
		{System.out.println("constructor 1");
		i++;}
	}
}
class use_Constructor_2 extends Thread
{
	use_Constructor_2()
	{
		super();
	}
	use_Constructor_2(String name)  //  User generated name
	{
		super(name);
	} 
	public void run()
	{ 
		int i=0;
		while(i<14)
		{System.out.println("constructor 2");
		i++;}
	}
}
public class ThreadConstructors {
   public static void main(String args[])
   {
	   use_Constructor_1 c1=new use_Constructor_1("High Thread");
	   c1.start();
	   use_Constructor_2 c2=new use_Constructor_2();
	   c2.start();
	   System.out.println(c1.getName());
	   System.out.println(c1.getId());
	   System.out.println(c2.getName());
	   System.out.println(c2.getId());
	   
   }
}
