/*
 * Let’s consider the example of Vehicles like bicycles, cars, and bikes share common functionalities,
 *  which can be defined in an interface, allowing each class (e.g., Bicycle, Car, Bike) to implement them in its own way.
 */
package radiobutton;

interface Vehicle
{
	void changeGear(int a);
	void speedUp(int a);
	void breakApplying(int a);
	
}

class Bike implements Vehicle
{
    int gear;
    int speed;
	@Override
	public void changeGear(int newgear) {
	   gear=newgear;
	 
	  
	}

	@Override
	public void speedUp(int increment)
	{

		speed+=increment;
	}

	@Override
	public void breakApplying(int decrement) {
       speed-=decrement;
		
	}
	public void display()
	{
		System.out.println("Speed: "+speed+" Gear: "+gear);
	}
}
class Car implements Vehicle
{
	    int gear;
	    int speed;
		@Override
		public void changeGear(int newgear) {
		  gear=newgear;
		
		  
		}

		@Override
		public void speedUp(int increment)
		{

			speed+=increment;
		}

		@Override
		public void breakApplying(int decrement) {
	       speed-=decrement;
			
		}
		public void display()
		{
			System.out.println("Speed: "+speed+" Gear: "+gear);
		}
}
public class Interface_Recap2 {
      public static void main(String[] args) {
		  Bike b1 =new Bike();
		  b1.changeGear(12);
		  b1.speedUp(10);
		  b1.breakApplying(3);
		  b1.display();
		  Car c1=new Car();
		  c1.changeGear(32);
		  c1.speedUp(10);
		  c1.breakApplying(1);
		  c1.display();
	}
}


