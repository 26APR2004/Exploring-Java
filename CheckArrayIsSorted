// Write java program to verify the array is sorted or not;
package com.company;

public class CheckArrayIsSorted {
	public static void main(String[ ]args)
	{
	int arr[]= {1,2,3,5};
	boolean isArraySorted=true;
	
	for(int i=0;i<arr.length-1;i++)
	{
		if(arr[i]>arr[i+1])
			{ isArraySorted=false;
		break;}
	}
	if(isArraySorted)
	{
		System.out.println("Array is sorted");
	}
	else
	{
		System.out.println("Array is not sortde");
	}
	}

}
