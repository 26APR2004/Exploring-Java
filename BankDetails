/*
 * Create a class of BankInfo and  declare variables CIF number ,pin code ,Bank_name as private and access this by using setter and getter;
 * Space Complexity=O(1);
 * Time Complexity=O(1);
 */
package com.company;
class BankInfo
{
	// Private
	private int CIF_Number;
	private int pin_code;
	private String Bank_name;
	// accessing private variables through methods
	public void setCIF_Number(int c)
	{
		CIF_Number=c;
	}
	public void setpin_code(int p)
	{
		pin_code=p;
	}
	public void setBank_name(String s)
	{
		Bank_name=s;
	}
	public int getCIF_Number()
	{
		return CIF_Number;
	}
	public int getpin_code()
	{
		return pin_code;
	}
	public String getBank_name()
	{
		return Bank_name;
	}
}
public class BankDetails {
  public static void main(String[]args)
  {
	  BankInfo b1=new  BankInfo();
	  b1.setCIF_Number(12345);
	 System.out.println("CIF number:"+ b1.getCIF_Number());
	 b1.setpin_code(2389);
	 System.out.println( "Pin ccode:"+b1.getpin_code());
	 b1.setBank_name("SBI");
	 System.out.println("Bank name:"+ b1.getBank_name());
	 
  }
}
