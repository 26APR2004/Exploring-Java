package com.company;

public class DisplayArrayInReverseOrder {
public static void main(String []args)
{
	int[] marks=new int[5];  //Declaration and memory allocation!
	
	marks[0]=24;
	marks[1]=89;
	marks[2]=74;
	marks[3]=94;
	marks[4]=24;
	
	// array length operation
	System.out.println("Length of array:"+marks.length);
	// Displaying array using for loop
	for(int i=0;i<marks.length;i++)
	{
		System.out.println(i);
	}
	
	// java program to display array in reverse order 
	System.out.println("array in reverse order:");
	for(int i=marks.length-1;i>=0;i--)
	{
		System.out.println(i);
	}
	// displaying array by using for-each loop
	System.out.println("array in for-each loopr:");
	for(int i:marks)
	{
		System.out.println(i);
	}
}
}
