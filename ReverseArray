/* Recursive code for printing  Reverse the array */
package com.company;

public class ReverseArray {
	static void reverse(int arr[],int n)
	{
		
		for(int i=n-1;i>=0;i--)
		{
	
			System.out.println(arr[i]);
		}
	}
public static void main(String[]args) {
	int n=5;
	int arr[]= {1,2,3,4,5};
	 reverse(arr, n);
		
	
}

}
