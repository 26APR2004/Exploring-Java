package com.Silver_Oak;

public class Rectangle extends Shape_1{
    int l;
    int w;
    Rectangle(int l,int w)
    {
    	this.l=l;
    	this.w=w;
    }
	@Override
	double area() {
		return l*w;
	}
	@Override
	double peri() {
		return 2*(l+w);
	}
    
}

