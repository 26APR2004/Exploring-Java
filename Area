/*
 * Create a class Square,circle,Area with a method to initialize it side ,calculate area and perimeter etc.
 * Space Complexity=O(1);
 * Time Complexity=O(1);
 */
package com.company;
import java.lang.Math;

class Square
{
	int side;
	public int areaCalculation()
	{
		return side*side;
	}
	public int perimeterCalculation()
	{
		return 4*side;
	}
	public int volumeCalculation()
	{
		return (int) Math.pow(side, 3);
	}
}

class Rectangle
{
	int length,width,height;
	
	public int areaCalculation()
	{
		return length*width;
	}
	public int volumeCalculation()
	{
		return length*width*height;
	}
	public int perimeterCalculation()
	{
		return 2*(length+width);
	}
}

class Circle
{
	int radius;
	static float pi=(float) 3.14;
	int height;
	public int areaCalculation( )
	{
		return (int) (pi*radius*radius);
	}
	public int volumeCalculation(int height )
	{
		return (int)(pi*Math.pow(radius, 2)*height);
	}
	public int perimeterCalculation()
	{
		return (int)(2*pi*radius);
	}
	
}
