/* Calculate the Average of marks from an array containing marks of all students in physcis using for loop */
package com.company;
import java.util.Scanner;
public class CalculateAVGOfMarks {
  public static void main(String args[])
  {
	  Scanner sc=new Scanner(System.in);
	  int marks[]=new int[5];
	  System.out.println("Enter the marks of Physics:");
	  for(int i=0;i<marks.length;i++)
	  {
		  marks[i]=sc.nextInt();
	  }
	  int sum=0;
	  for(int i=0;i<marks.length;i++)
	  {
		  sum+=marks[i];
	  }
	  System.out.println("Addition of the all the elements of the array:"+sum);
	 
		 int Avg=sum/marks.length;
	  System.out.println("Average of Marks:"+Avg);
	  
  }
}
