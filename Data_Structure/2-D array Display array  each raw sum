// 2-D array Display array  each raw sum
package Data_Structure;
import java.util.Scanner;
public class TwoRarrays {
  public static void main(String[] args) {
	  
      int a[][]= {
    		  {1,2,3},
    		  {4,5,6},
    		  {7,8,9}
      };
      // Display array
      System.out.println("Array raw :");
     
      for (int i = 0; i < a.length; i++) {
    	  int rawadd=0;
    	
		for (int j = 0; j < a.length; j++) {
			rawadd=rawadd+a[i][j];
			
			System.out.print(a[i][j]+" ");
		}
		System.out.println(":"+rawadd);
		
		
	}
      System.out.println("Array column :");
      for (int i = 0; i < a.length; i++) {
    	  
    	  int coulmn=0;
		for (int j = 0; j < a.length; j++) {
			
			coulmn+=a[j][i];
			System.out.print(a[i][j]+" ");
			
		}
		

		System.out.println(":"+coulmn);
      
}
}}
