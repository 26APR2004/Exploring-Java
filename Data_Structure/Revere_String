// Reveres String
package Data_Structure;

public class Revere_String {
	public static void revere(char str[])
	{    
		int i=0;
		int n=str.length-1;
		while(i<n)
		{
		char temp=str[i];
		str[i]=str[n];
		str[n]=temp;
		i++;
		n--;
		}
		System.out.println("Revered String is:");
		for (char c : str) {
			System.out.print(c);
			
		}
	}
  public static void main(String[] args) {
	  String s="Sujal";
	  char []str=s.toCharArray();
	  
	  revere(str);
}
}
