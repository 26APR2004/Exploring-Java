/* Recursive code for printing  Sum of first N numbers */
package com.company;
import java.util.Scanner;
public class RecursionToDisplaySumOfNumbers {
	static int sum=0;
	static int sum(int i)
	{
		if(i==0)
		  return 0;
		return i+sum(i-1);
	}
public static void main(String[]args)
{
	Scanner sc=new Scanner(System.in);
	System.out.print("Enter the number:");
	int n=sc.nextInt();
	int sum=sum(n);
	System.out.println("sum:"+sum);
}
}
