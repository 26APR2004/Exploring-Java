	// optimal program
	static public int Primenumber(int n)
	{
		int counter=0;
		for(int i=1;i*i<=n;i++)
		{
			if(n%i==0)
			{
				counter++;
				if(n/i!=i)
					counter++;
			}
		}
		return counter;
	}
public static void main(String[]args)
{
	System.out.print("Enter the number:");
	Scanner sc=new Scanner(System.in);
	int n=sc.nextInt();
	int result=Primenumber(n);
	if(result==2)
		System.out.printf(" %d number is Prime Number:",n);
	else
		System.out.printf(" %d number is not  Prime Number:",n);
}
}

