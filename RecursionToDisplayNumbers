/* Recursive code for printing numbers from 0 to 3 */

package com.company;

public class RecursionToDisplayNumbers {
	static int count=0;
	static void Print()
	{
	     
	      if(count==3)return;
	    	 System.out.print(count+" ");
	         count++;
	         Print();
		

	}
public static void main(String[]args)
{
	
	Print();
}
}
